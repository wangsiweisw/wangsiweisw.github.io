---
// Base page shell: <head> metadata, site header, main slot, footer.
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

// TODO(owner): name and default description move to src/data/site.yaml in Phase 2.
const siteName = '{{NAME}}';
const { title, description = 'Personal website of {{NAME}}.' } = Astro.props;
const pageTitle = title === siteName ? title : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <a href="/">{siteName}</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">© {new Date().getFullYear()} {siteName}</footer>
  </body>
</html>
