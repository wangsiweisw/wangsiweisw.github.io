---
// Base page shell: <head> metadata (SEO + Open Graph), fonts, theme bootstrap, header, main slot, footer.
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  showUnits?: boolean;
  ogType?: 'website' | 'article';
}

const { title, description = site.description, showUnits = false, ogType = 'website' } = Astro.props;
const pageTitle = title === site.name ? title : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Blog`} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <script is:inline>
      // Apply saved theme/units before first paint.
      (function () {
        var root = document.documentElement;
        var theme = null;
        var units = null;
        try {
          theme = localStorage.getItem('theme');
          units = localStorage.getItem('units');
        } catch (e) {}
        if (theme === 'light' || theme === 'dark') root.dataset.theme = theme;
        var dark = theme ? theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.effectiveTheme = dark ? 'dark' : 'light';
        root.dataset.units = units === 'metric' ? 'metric' : 'imperial';
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <Header showUnits={showUnits} />
    <main class="wrap">
      <slot />
    </main>
    <Footer />
  </body>
</html>
