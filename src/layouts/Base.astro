---
// Base page shell: <head> metadata (SEO + Open Graph), fonts, theme bootstrap, header, main slot, footer.
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { existsSync } from 'node:fs';
import { site } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** show the imperial/metric toggle, labeled for what the page measures */
  showUnits?: boolean | 'distance' | 'temperature';
  ogType?: 'website' | 'article';
  /** link-preview card in public/og/ (made by `pnpm og:cards`); falls back to the default card */
  og?: string;
}

const { title, description = site.description, showUnits = false, ogType = 'website', og = 'default' } = Astro.props;
const pageTitle = title.startsWith(site.name) ? title : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`/og/${existsSync(`public/og/${og}.jpg`) ? og : 'default'}.jpg`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Blog`} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <script is:inline>
      // Apply saved theme/units before first paint.
      (function () {
        var root = document.documentElement;
        var theme = null;
        var units = null;
        try {
          theme = localStorage.getItem('theme');
          units = localStorage.getItem('units');
        } catch (e) {}
        if (theme === 'light' || theme === 'dark') root.dataset.theme = theme;
        // No saved choice: dark if the OS asks for it, or once the sun is down where the visitor is
        // (position guessed from the time zone; no location request). Same math as sunIsDown() in scripts/prefs.ts.
        var sunDown = function () {
          var now = new Date();
          var y = now.getFullYear();
          var std = Math.max(new Date(y, 0, 1).getTimezoneOffset(), new Date(y, 6, 1).getTimezoneOffset());
          var lon = -std / 4;
          var lat = 40;
          var r = Math.PI / 180;
          var d = now.getTime() / 864e5 - 10957.5;
          var g = (357.529 + 0.98560028 * d) * r;
          var L = (280.459 + 0.98564736 * d) * r + (1.915 * Math.sin(g) + 0.02 * Math.sin(2 * g)) * r;
          var e = (23.439 - 3.6e-7 * d) * r;
          var ra = Math.atan2(Math.cos(e) * Math.sin(L), Math.cos(L));
          var dec = Math.asin(Math.sin(e) * Math.sin(L));
          var ha = (18.697374558 + 24.06570982441908 * d) * 15 * r + lon * r - ra;
          return Math.sin(lat * r) * Math.sin(dec) + Math.cos(lat * r) * Math.cos(dec) * Math.cos(ha) < Math.sin(-3 * r);
        };
        var dark = theme ? theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches || sunDown();
        root.dataset.effectiveTheme = dark ? 'dark' : 'light';
        root.dataset.units = units === 'metric' ? 'metric' : 'imperial';
      })();
    </script>
    <slot name="head" />
    {
      import.meta.env.PROD && (
        // Cloudflare Web Analytics: cookie-free visit counts; production builds only.
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon='{"token": "254d6e610fef46e193f689dc8c2e2e41"}'
        />
      )
    }
    {
      import.meta.env.PROD && (
        // Umami: cookie-free analytics with city-level location; production builds only.
        <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="86f3eed6-bade-4758-ab8c-360b9b983208" />
      )
    }
  </head>
  <body>
    <Header showUnits={showUnits} />
    <main class="wrap">
      <slot />
    </main>
    <Footer />
    <CommandPalette />
  </body>
</html>
