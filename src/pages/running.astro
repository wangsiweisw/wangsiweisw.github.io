---
// Running: a modest intro, a few totals, a yearly-distance bar chart (build-time SVG), and two photos.
import Base from '../layouts/Base.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import { running, runningPhotos, METERS_PER_MILE, duration } from '../lib/running';
import weather from '../data/running-weather.json';
import RunWeather from '../components/RunWeather.astro';

const miles = (m: number) => Math.round(m / METERS_PER_MILE).toLocaleString('en-US');
const since = new Date(`${running.since}-01T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const [firstYear, lastYear] = [running.years[0]?.year, running.years.at(-1)?.year];
const sinceMonth = new Date(`${running.since}-01T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' });

// Chart geometry (viewBox units)
const W = 640;
const H = 250;
const top = 34;
const base = 196;
const barW = 96;
const slot = W / running.years.length;
const max = Math.max(...running.years.map((y) => y.meters));
const bars = running.years.map((y, i) => {
  const h = Math.max(4, ((base - top) * y.meters) / max);
  const x = slot * i + (slot - barW) / 2;
  const note = y.year === firstYear && running.since.slice(5) !== '01' ? `from ${sinceMonth}` : y.year === lastYear ? 'so far' : '';
  return { ...y, x, h, y: base - h, note };
});
// rounded top corners only (4px), square at the baseline
const barPath = (x: number, y: number, w: number, h: number, r = 4) =>
  `M${x},${base} V${y + r} Q${x},${y} ${x + r},${y} H${x + w - r} Q${x + w},${y} ${x + w},${y + r} V${base} Z`;

// Heart rate by dew point (build-time SVG): one dot per bin, pace written underneath.
const fToC = (f: number) => Math.round(((f - 32) * 5) / 9);
const dew = weather.dewPoint.filter((b) => b.runs >= 5 && b.heartRate && b.paceSecPerKm);
const dewLabel = (b: (typeof dew)[number], c = false) => {
  const t = (f: number) => (c ? fToC(f) : f);
  const u = c ? '°C' : '°F';
  return b.loF == null ? `below ${t(b.hiF!)}${u}` : b.hiF == null ? `${t(b.loF)}${u}+` : `${t(b.loF)}–${t(b.hiF)}${u}`;
};
const pace = (secPerKm: number) => {
  const s = Math.round(secPerKm * (METERS_PER_MILE / 1000));
  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')} /mi`;
};
const hrs = dew.map((b) => b.heartRate!);
const [hrLo, hrHi] = [Math.min(...hrs) - 4, Math.max(...hrs) + 4];
const WW = 640;
const WH = 214;
const wTop = 40;
const wBase = 140;
const wSlot = WW / Math.max(1, dew.length);
const dots = dew.map((b) => ({ ...b, x: 0, y: wBase - ((b.heartRate! - hrLo) / (hrHi - hrLo)) * (wBase - wTop) }));
dots.forEach((d, i) => (d.x = wSlot * i + wSlot / 2));
const [dry, muggy] = [dew[0], dew.at(-1)];

// "Weather I've run in": one stripe per outdoor run, coldest to warmest, from the temperature bins (no dates).
const temps = weather.temperature.filter((b) => b.runs > 0);
const typicalPace = Math.round(temps.reduce((a, b) => a + b.paceSecPerKm * b.runs, 0) / temps.reduce((a, b) => a + b.runs, 0));
const SW = 640;
const SH = 84;
const GAP = 4;
const stripeW = (SW - GAP * (temps.length - 1)) / weather.runs;
let cursor = 0;
const groups = temps.map((b, i) => {
  const x = cursor;
  const w = b.runs * stripeW;
  cursor += w + GAP;
  // open-ended bins get a 15°F span so today's marker has somewhere to sit
  const lo = b.loF ?? b.hiF! - 15;
  const hi = b.hiF ?? b.loF! + 15;
  return { ...b, i, x, w, lo, hi };
});
const tempLabel = (b: (typeof temps)[number], c = false) => {
  const t = (f: number) => (c ? fToC(f) : f);
  const u = c ? '°C' : '°F';
  return b.loF == null ? `below ${t(b.hiF!)}${u}` : b.hiF == null ? `${t(b.loF)}${u}+` : `${t(b.loF)}–${t(b.hiF)}${u}`;
};
const paces = temps.map((b) => b.paceSecPerKm);
const coldest = temps[0];
const hrGap = dry && muggy ? muggy.heartRate! - dry.heartRate! : 0;
---

<Base title="Running" description="Siwei Wang's running: totals since 2024, and a couple of race-day photos." showUnits="distance" og="running">
  <header class="page-head">
    <h1>Running</h1>
    <p class="intro">
      I started running in the fall of 2024 and got hooked, mostly easy miles with a few races along the way. An IT band
      injury in spring 2026 slowed me down to walks and rest; I'm running again, and in October I finished my first half
      marathon since the injury.
    </p>
  </header>

  <RunWeather paceSecPerKm={typicalPace} />

  <dl class="stats" data-reveal>
    <div><dt>Running since</dt><dd>{since}</dd></div>
    <div><dt>Distance</dt><dd data-meters={running.meters}>{miles(running.meters)} mi</dd></div>
    <div><dt>Runs</dt><dd>{running.runs.toLocaleString('en-US')}</dd></div>
    <div><dt>Half marathons</dt><dd>{running.halfMarathons}</dd></div>
  </dl>

  <h2 class="kicker pb-title">Best times</h2>
  <dl class="stats pbs" data-reveal>
    {(running.bestEfforts.fiveK ?? duration(running.fastest5kSeconds)) && (
      <div><dt>5K</dt><dd>{running.bestEfforts.fiveK ?? duration(running.fastest5kSeconds)}</dd></div>
    )}
    {(running.bestEfforts.tenK ?? duration(running.fastest10kSeconds)) && (
      <div><dt>10K</dt><dd>{running.bestEfforts.tenK ?? duration(running.fastest10kSeconds)}</dd></div>
    )}
    <div><dt>Half marathon</dt><dd>{running.halfPB}</dd></div>
  </dl>

  {
    running.milestones.length > 0 && (
      <section class="milestones" aria-labelledby="milestones-title" data-reveal>
        <h2 id="milestones-title" class="kicker">Milestones</h2>
        <ol>
          {running.milestones.map((m) => (
            <li>
              <time datetime={m.month}>
                {new Date(`${m.month}-01T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })}
              </time>
              <span class="what">{m.title}</span>
              {m.time && <span class="time">{m.time}</span>}
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="chart years" aria-labelledby="chart-title" data-reveal>
    <h2 id="chart-title" class="kicker">Distance per year</h2>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="chart-title chart-desc">
      <desc id="chart-desc">{bars.map((b) => `${b.year}${b.note ? ` (${b.note})` : ''}: ${miles(b.meters)} miles, ${b.runs} runs`).join('; ')}</desc>
      <line x1="0" x2={W} y1={base} y2={base} class="axis" />
      {
        bars.map((b) => (
          <g class="bar" tabindex="0" aria-label={`${b.year}: ${miles(b.meters)} miles over ${b.runs} runs`}>
            <title>{`${b.year}${b.note ? ` (${b.note})` : ''}: ${miles(b.meters)} mi · ${b.runs} runs`}</title>
            <rect x={b.x - 12} y={top - 24} width={barW + 24} height={H - top + 24} class="hit" />
            <path d={barPath(b.x, b.y, barW, b.h)} class="fill" />
            <text x={b.x + barW / 2} y={b.y - 10} class="value" data-meters={b.meters}>
              {miles(b.meters)} mi
            </text>
            <text x={b.x + barW / 2} y={base + 22} class="year">
              {b.year}
            </text>
            {b.note && (
              <text x={b.x + barW / 2} y={base + 40} class="note">
                {b.note}
              </text>
            )}
          </g>
        ))
      }
    </svg>
  </section>

  {
    groups.length >= 3 && (
      <section class="chart stripes" aria-labelledby="stripes-title" data-reveal>
        <h2 id="stripes-title" class="kicker">The weather I've run in</h2>
        <p class="finding">
          {weather.runs} outdoor runs, coldest to warmest. Most were cold ones, {coldest.runs} of them{' '}
          <span data-dew-f={tempLabel(coldest)} data-dew-c={tempLabel(coldest, true)}>{tempLabel(coldest)}</span>, and my pace
          hardly moves with the temperature: <span data-pace={Math.min(...paces)}>{pace(Math.min(...paces))}</span> to{' '}
          <span data-pace={Math.max(...paces)}>{pace(Math.max(...paces))}</span>.
        </p>
        <div class="stripe-box" data-stripes={JSON.stringify(groups.map((g) => [g.x, g.w, g.lo, g.hi]))} data-width={SW}>
          <svg viewBox={`0 0 ${SW} ${SH}`} role="img" aria-labelledby="stripes-title stripes-desc">
            <desc id="stripes-desc">{groups.map((g) => `${tempLabel(g)}: ${g.runs} runs`).join('; ')}</desc>
            {
              groups.map((g) => (
                <g class={`band t${g.i}`} tabindex="0" aria-label={`${tempLabel(g)}: ${g.runs} runs, median pace ${pace(g.paceSecPerKm)}, heart rate ${g.heartRate} bpm`}>
                  <title>{`${tempLabel(g)} · ${g.runs} runs · ${pace(g.paceSecPerKm)} · ${g.heartRate} bpm`}</title>
                  {Array.from({ length: g.runs }, (_, k) => (
                    <rect x={g.x + k * stripeW} y="0" width={stripeW + 0.4} height={SH} style={`--k:${k}`} />
                  ))}
                </g>
              ))
            }
          </svg>
          <div class="today" data-today hidden>
            <span>Today</span>
          </div>
        </div>
        <table class="bands">
          <thead>
            <tr><th>Temperature</th><th>Runs</th><th>Pace</th><th>Heart rate</th></tr>
          </thead>
          <tbody>
            {groups.map((g) => (
              <tr>
                <td><i class={`sw t${g.i}`} aria-hidden="true" /><span data-dew-f={tempLabel(g)} data-dew-c={tempLabel(g, true)}>{tempLabel(g)}</span></td>
                <td>{g.runs}</td>
                <td data-pace={g.paceSecPerKm}>{pace(g.paceSecPerKm)}</td>
                <td>{g.heartRate} bpm</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="method">
          Air temperature at the time of each run, from <a href="https://open-meteo.com/">Open-Meteo</a>’s historical
          weather; medians per band. "Today" is the live reading above. Pace adjustment on hot days follows Mark Hadley's{' '}
          <a href="https://maximumperformancerunning.blogspot.com/2013/07/temperature-dew-point.html">temperature + dew point table</a>.
        </p>
      </section>
    )
  }
  {
    dots.length >= 3 && hrGap > 0 && (
      <section class="chart weather" aria-labelledby="weather-title" data-reveal>
        <h2 id="weather-title" class="kicker">Heart rate vs. humidity (dew point)</h2>
        <p class="finding">
          On muggy days my heart works about <strong>{hrGap} bpm</strong> harder than on dry ones, while my pace barely
          changes.
        </p>
        <svg viewBox={`0 0 ${WW} ${WH}`} role="img" aria-labelledby="weather-title weather-desc">
          <desc id="weather-desc">
            {dots.map((d) => `Dew point ${dewLabel(d)}: median heart rate ${d.heartRate} bpm, pace ${pace(d.paceSecPerKm!)}, ${d.runs} runs`).join('; ')}
          </desc>
          <defs>
            <linearGradient id="muggy" x1="0" x2="1" y1="0" y2="0">
              <stop offset="0" class="dry" />
              <stop offset="1" class="wet" />
            </linearGradient>
          </defs>
          <rect x="0" y={wTop - 30} width={WW} height={wBase - wTop + 50} rx="6" fill="url(#muggy)" />
          <text x="10" y={wTop - 14} class="edge">drier air</text>
          <text x={WW - 10} y={wTop - 14} class="edge end">muggier air</text>
          <polyline points={dots.map((d) => `${d.x},${d.y}`).join(' ')} class="line" pathLength="1" />
          {
            dots.map((d) => (
              <g class="pt" tabindex="0" aria-label={`Dew point ${dewLabel(d)}: ${d.heartRate} bpm over ${d.runs} runs`}>
                <title>{`Dew point ${dewLabel(d)} · ${d.heartRate} bpm · ${pace(d.paceSecPerKm!)} · ${d.runs} runs`}</title>
                <rect x={d.x - wSlot / 2} y="0" width={wSlot} height={WH} class="hit" />
                <circle cx={d.x} cy={d.y} r="6" class="dot" />
                <text x={d.x} y={d.y - 16} class="value">{d.heartRate} bpm</text>
                <text x={d.x} y={wBase + 40} class="year" data-dew-f={dewLabel(d)} data-dew-c={dewLabel(d, true)}>
                  {dewLabel(d)}
                </text>
                <text x={d.x} y={wBase + 60} class="note" data-pace={d.paceSecPerKm}>
                  {pace(d.paceSecPerKm!)}
                </text>
              </g>
            ))
          }
        </svg>
        <p class="method">
          Dew point at the time of each run, from <a href="https://open-meteo.com/">Open-Meteo</a>’s historical weather.
          Medians of {weather.runs} outdoor runs; treadmill runs left out.
        </p>
      </section>
    )
  }
  {
    runningPhotos.length > 0 && (
      <section class="photos">
        <PhotoGrid photos={runningPhotos} rowHeight={360} contentWidth={704} />
        <Lightbox photos={runningPhotos} details={false} />
      </section>
    )
  }
</Base>

<style>
  /* --- scroll-in (only once the script has marked the page; without JS everything is simply shown) --- */
  :global(.reveal-on) [data-reveal] {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  :global(.reveal-on) [data-reveal].in {
    opacity: 1;
    transform: none;
  }
  :global(.reveal-on) .milestones li {
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.45s ease, transform 0.45s ease;
    transition-delay: calc(var(--n) * 90ms + 150ms);
  }
  :global(.reveal-on) .milestones.in li {
    opacity: 1;
    transform: none;
  }
  :global(.reveal-on) .years .fill {
    transform: scaleY(0);
    transform-box: fill-box;
    transform-origin: bottom;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s;
  }
  :global(.reveal-on) .years.in .fill {
    transform: none;
  }
  :global(.reveal-on) .weather .line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.2s ease 0.2s;
  }
  :global(.reveal-on) .weather.in .line {
    stroke-dashoffset: 0;
  }
  :global(.reveal-on) .stripes rect {
    opacity: 0;
    transition: opacity 0.3s ease;
    transition-delay: calc(var(--k) * 6ms + 100ms);
  }
  :global(.reveal-on) .stripes.in rect {
    opacity: 1;
  }
  .page-head {
    padding: 3rem 0 2.5rem;
  }
  h1 {
    margin: 0;
    font: 400 clamp(2.4rem, 6vw, 3.5rem) / 1 var(--display);
    letter-spacing: -0.03em;
  }
  .intro {
    max-width: var(--measure);
    margin: 1rem 0 0;
    font: 400 1.2rem / 1.5 var(--display);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 1px;
    margin: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--rule);
  }
  .stats div {
    padding: 1.1rem 1.25rem;
    background: var(--surface);
  }
  .stats dt {
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }
  .stats dd {
    margin: 0.3rem 0 0;
    font: 400 1.7rem / 1.1 var(--display);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .pb-title {
    margin: 2rem 0 0.75rem;
    font-weight: 500;
  }
  .milestones {
    max-width: 44rem;
    margin-top: 3.5rem;
  }
  .milestones .kicker {
    margin: 0 0 1.25rem;
  }
  .milestones ol {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* the line joining the dots */
  .milestones ol::before {
    content: '';
    position: absolute;
    top: 0.6rem;
    bottom: 0.6rem;
    left: 5px;
    width: 2px;
    background: var(--rule);
  }
  .milestones li {
    position: relative;
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    align-items: baseline;
    gap: 0 1rem;
    padding: 0.55rem 0 0.55rem 1.75rem;
  }
  .milestones li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .milestones li:last-child::before {
    background: var(--accent);
  }
  .milestones time {
    color: var(--muted);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  .milestones .what {
    font: 400 1.15rem var(--display);
  }
  .milestones .time {
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .milestones li {
      grid-template-columns: 1fr auto;
    }
    .milestones time {
      grid-column: 1 / -1;
    }
  }
  .chart {
    margin-top: 3.5rem;
    max-width: 44rem;
    --bar: #b4532a;
  }
  :global([data-effective-theme='dark']) .chart {
    --bar: #d4683f;
  }
  .chart .kicker {
    margin: 0 0 1rem;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .axis {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .hit {
    fill: transparent;
  }
  .fill {
    fill: var(--bar);
    transition: opacity var(--ease);
  }
  .bar:hover .fill,
  .bar:focus-visible .fill {
    opacity: 0.8;
  }
  .bar:focus-visible {
    outline: none;
  }
  .bar:focus-visible .hit {
    stroke: var(--accent);
    stroke-width: 2;
  }
  .value {
    fill: var(--fg);
    font: 500 15px var(--body);
    text-anchor: middle;
    font-variant-numeric: tabular-nums;
  }
  .year {
    fill: var(--fg);
    font: 400 15px var(--body);
    text-anchor: middle;
  }
  .note {
    fill: var(--muted);
    font: 400 13px var(--body);
    text-anchor: middle;
  }
  .finding {
    margin: 0 0 1.25rem;
    font: 400 1.15rem / 1.5 var(--display);
  }
  .finding strong {
    font-weight: 500;
    color: var(--accent);
  }
  .line {
    fill: none;
    stroke: var(--bar);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .dot {
    fill: var(--bar);
    stroke: var(--bg);
    stroke-width: 2;
    transition: r var(--ease);
  }
  .pt:hover .dot,
  .pt:focus-visible .dot {
    r: 8;
  }
  .pt:focus-visible {
    outline: none;
  }
  .method {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .method a {
    color: inherit;
  }
  /* --- weather I've run in: cold blue to warm terracotta, neutral in the middle --- */
  .stripes {
    --t0: #3f6fa8;
    --t1: #8aa9c9;
    --t2: #c3bcb0;
    --t3: #d98d64;
    --t4: #b4532a;
  }
  :global([data-effective-theme='dark']) .stripes {
    --t0: #5b88c2;
    --t1: #8fa9c4;
    --t2: #8a8378;
    --t3: #d98d64;
    --t4: #d4683f;
  }
  .t0 { fill: var(--t0); background: var(--t0); }
  .t1 { fill: var(--t1); background: var(--t1); }
  .t2 { fill: var(--t2); background: var(--t2); }
  .t3 { fill: var(--t3); background: var(--t3); }
  .t4 { fill: var(--t4); background: var(--t4); }
  .stripe-box {
    position: relative;
    margin-top: 2rem;
  }
  .stripe-box svg {
    border-radius: 6px;
    overflow: hidden;
  }
  .band {
    outline: none;
    transition: opacity var(--ease);
  }
  .stripe-box svg:has(.band:hover, .band:focus-visible) .band:not(:hover, :focus-visible) {
    opacity: 0.35;
  }
  .today {
    position: absolute;
    top: -1.6rem;
    bottom: -0.35rem;
    width: 2px;
    margin-left: -1px;
    background: var(--fg);
    transition: left 0.8s ease;
  }
  .today[hidden] {
    display: none;
  }
  .today span {
    position: absolute;
    top: 0;
    left: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .today.flip span {
    left: auto;
    right: 6px;
  }
  .bands {
    width: 100%;
    margin-top: 1.1rem;
    border-collapse: collapse;
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
  }
  .bands th {
    color: var(--muted);
    font-weight: 500;
    font-size: 0.78rem;
    text-align: left;
    padding: 0 0 0.35rem;
  }
  .bands td {
    padding: 0.35rem 0;
    border-top: 1px solid var(--rule);
  }
  .bands th:not(:first-child),
  .bands td:not(:first-child) {
    text-align: right;
  }
  .bands .sw {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 0.5rem;
    border-radius: 2px;
  }
  /* dew point chart: drier to muggier backdrop */
  .weather .dry {
    stop-color: var(--surface);
  }
  .weather .wet {
    stop-color: color-mix(in oklab, var(--bar) 22%, var(--surface));
  }
  .edge {
    fill: var(--muted);
    font: 400 12px var(--body);
  }
  .edge.end {
    text-anchor: end;
  }
  .photos {
    max-width: 44rem;
    margin-top: 3.5rem;
  }
</style>

<script>
  // Re-render distances in the visitor's unit (imperial by default).
  const KM_PER_MILE = 1.609344;
  function render() {
    const metric = document.documentElement.dataset.units === 'metric';
    document.querySelectorAll<HTMLElement | SVGTextElement>('[data-meters]').forEach((el) => {
      const m = Number(el.dataset.meters);
      const value = metric ? m / 1000 : m / (1000 * KM_PER_MILE);
      el.textContent = `${Math.round(value).toLocaleString('en-US')} ${metric ? 'km' : 'mi'}`;
    });
    document.querySelectorAll<SVGTextElement>('[data-dew-f]').forEach((el) => {
      el.textContent = (metric ? el.dataset.dewC : el.dataset.dewF) ?? '';
    });
    document.querySelectorAll<SVGTextElement>('[data-pace]').forEach((el) => {
      const s = Math.round(Number(el.dataset.pace) * (metric ? 1 : KM_PER_MILE));
      el.textContent = `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')} /${metric ? 'km' : 'mi'}`;
    });
  }
  render();
  document.addEventListener('unitschange', render);

  // Today's temperature on the stripes, once the live card has it.
  document.addEventListener('runweather', (e) => {
    const box = document.querySelector<HTMLElement>('[data-stripes]');
    const mark = box?.querySelector<HTMLElement>('[data-today]');
    if (!box || !mark) return;
    const tempF = (e as CustomEvent<{ tempF: number }>).detail.tempF;
    const groups: [number, number, number, number][] = JSON.parse(box.dataset.stripes!);
    const width = Number(box.dataset.width);
    const g = groups.find(([, , , hi], i) => tempF < hi || i === groups.length - 1)!;
    const f = Math.min(1, Math.max(0, (tempF - g[2]) / (g[3] - g[2])));
    const x = (g[0] + g[1] * f) / width;
    mark.style.left = `${x * 100}%`;
    mark.classList.toggle('flip', x > 0.8);
    const metric = document.documentElement.dataset.units === 'metric';
    mark.querySelector('span')!.textContent = `Today ${metric ? Math.round(((tempF - 32) * 5) / 9) + '°C' : Math.round(tempF) + '°F'}`;
    mark.hidden = false;
  });

  // Sections ease in as they scroll into view; numbers count up once. Skipped when motion is reduced.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('reveal-on');
    document.querySelectorAll<HTMLElement>('.milestones li').forEach((li, i) => li.style.setProperty('--n', String(i)));
    const countUp = (el: HTMLElement) => {
      const m = el.textContent!.match(/^([\d,]+)(.*)$/);
      if (!m) return;
      const end = Number(m[1].replace(/,/g, ''));
      const t0 = performance.now();
      const step = (t: number) => {
        const p = Math.min(1, (t - t0) / 900);
        el.textContent = `${Math.round(end * (1 - (1 - p) ** 3)).toLocaleString('en-US')}${m[2]}`;
        if (p < 1) requestAnimationFrame(step);
        else render();
      };
      requestAnimationFrame(step);
    };
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('in');
          e.target.querySelectorAll<HTMLElement>('.stats:not(.pbs) dd').forEach(countUp);
          io.unobserve(e.target);
        }),
      { rootMargin: '0px 0px -12% 0px' },
    );
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
  }
</script>
