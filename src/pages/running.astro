---
// Running: a modest intro, a few totals, a yearly-distance bar chart (build-time SVG), and two photos.
import Base from '../layouts/Base.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import { running, runningPhotos, METERS_PER_MILE, duration } from '../lib/running';
import weather from '../data/running-weather.json';

const miles = (m: number) => Math.round(m / METERS_PER_MILE).toLocaleString('en-US');
const since = new Date(`${running.since}-01T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const [firstYear, lastYear] = [running.years[0]?.year, running.years.at(-1)?.year];
const sinceMonth = new Date(`${running.since}-01T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' });

// Chart geometry (viewBox units)
const W = 640;
const H = 250;
const top = 34;
const base = 196;
const barW = 96;
const slot = W / running.years.length;
const max = Math.max(...running.years.map((y) => y.meters));
const bars = running.years.map((y, i) => {
  const h = Math.max(4, ((base - top) * y.meters) / max);
  const x = slot * i + (slot - barW) / 2;
  const note = y.year === firstYear && running.since.slice(5) !== '01' ? `from ${sinceMonth}` : y.year === lastYear ? 'so far' : '';
  return { ...y, x, h, y: base - h, note };
});
// rounded top corners only (4px), square at the baseline
const barPath = (x: number, y: number, w: number, h: number, r = 4) =>
  `M${x},${base} V${y + r} Q${x},${y} ${x + r},${y} H${x + w - r} Q${x + w},${y} ${x + w},${y + r} V${base} Z`;

// Heart rate by dew point (build-time SVG): one dot per bin, pace written underneath.
const fToC = (f: number) => Math.round(((f - 32) * 5) / 9);
const dew = weather.dewPoint.filter((b) => b.runs >= 5 && b.heartRate && b.paceSecPerKm);
const dewLabel = (b: (typeof dew)[number], c = false) => {
  const t = (f: number) => (c ? fToC(f) : f);
  const u = c ? '°C' : '°F';
  return b.loF == null ? `below ${t(b.hiF!)}${u}` : b.hiF == null ? `${t(b.loF)}${u}+` : `${t(b.loF)}–${t(b.hiF)}${u}`;
};
const pace = (secPerKm: number) => {
  const s = Math.round(secPerKm * (METERS_PER_MILE / 1000));
  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')} /mi`;
};
const hrs = dew.map((b) => b.heartRate!);
const [hrLo, hrHi] = [Math.min(...hrs) - 4, Math.max(...hrs) + 4];
const WW = 640;
const WH = 214;
const wTop = 40;
const wBase = 140;
const wSlot = WW / Math.max(1, dew.length);
const dots = dew.map((b) => ({ ...b, x: 0, y: wBase - ((b.heartRate! - hrLo) / (hrHi - hrLo)) * (wBase - wTop) }));
dots.forEach((d, i) => (d.x = wSlot * i + wSlot / 2));
const [dry, muggy] = [dew[0], dew.at(-1)];
const hrGap = dry && muggy ? muggy.heartRate! - dry.heartRate! : 0;
---

<Base title="Running" description="Siwei Wang's running: totals since 2024, and a couple of race-day photos." showUnits="distance" og="running">
  <header class="page-head">
    <h1>Running</h1>
    <p class="intro">
      I started running in the fall of 2024 and got hooked, mostly easy miles with a few races along the way. An IT band
      injury in spring 2026 slowed me down to walks and rest; I've just started running again, most recently a 10-miler.
    </p>
  </header>

  <dl class="stats">
    <div><dt>Running since</dt><dd>{since}</dd></div>
    <div><dt>Distance</dt><dd data-meters={running.meters}>{miles(running.meters)} mi</dd></div>
    <div><dt>Runs</dt><dd>{running.runs.toLocaleString('en-US')}</dd></div>
    <div><dt>Half marathons</dt><dd>{running.halfMarathons}</dd></div>
  </dl>

  <h2 class="kicker pb-title">Best times</h2>
  <dl class="stats pbs">
    {(running.bestEfforts.fiveK ?? duration(running.fastest5kSeconds)) && (
      <div><dt>5K</dt><dd>{running.bestEfforts.fiveK ?? duration(running.fastest5kSeconds)}</dd></div>
    )}
    {(running.bestEfforts.tenK ?? duration(running.fastest10kSeconds)) && (
      <div><dt>10K</dt><dd>{running.bestEfforts.tenK ?? duration(running.fastest10kSeconds)}</dd></div>
    )}
    <div><dt>Half marathon</dt><dd>{running.halfPB}</dd></div>
  </dl>

  {
    running.milestones.length > 0 && (
      <section class="milestones" aria-labelledby="milestones-title">
        <h2 id="milestones-title" class="kicker">Milestones</h2>
        <ol>
          {running.milestones.map((m) => (
            <li>
              <time datetime={m.month}>
                {new Date(`${m.month}-01T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })}
              </time>
              <span class="what">{m.title}</span>
              {m.time && <span class="time">{m.time}</span>}
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="chart" aria-labelledby="chart-title">
    <h2 id="chart-title" class="kicker">Distance per year</h2>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="chart-title chart-desc">
      <desc id="chart-desc">{bars.map((b) => `${b.year}${b.note ? ` (${b.note})` : ''}: ${miles(b.meters)} miles, ${b.runs} runs`).join('; ')}</desc>
      <line x1="0" x2={W} y1={base} y2={base} class="axis" />
      {
        bars.map((b) => (
          <g class="bar" tabindex="0" aria-label={`${b.year}: ${miles(b.meters)} miles over ${b.runs} runs`}>
            <title>{`${b.year}${b.note ? ` (${b.note})` : ''}: ${miles(b.meters)} mi · ${b.runs} runs`}</title>
            <rect x={b.x - 12} y={top - 24} width={barW + 24} height={H - top + 24} class="hit" />
            <path d={barPath(b.x, b.y, barW, b.h)} class="fill" />
            <text x={b.x + barW / 2} y={b.y - 10} class="value" data-meters={b.meters}>
              {miles(b.meters)} mi
            </text>
            <text x={b.x + barW / 2} y={base + 22} class="year">
              {b.year}
            </text>
            {b.note && (
              <text x={b.x + barW / 2} y={base + 40} class="note">
                {b.note}
              </text>
            )}
          </g>
        ))
      }
    </svg>
  </section>

  {
    dots.length >= 3 && hrGap > 0 && (
      <section class="chart weather" aria-labelledby="weather-title">
        <h2 id="weather-title" class="kicker">Heart rate vs. humidity (dew point)</h2>
        <p class="finding">
          On muggy days my heart works about <strong>{hrGap} bpm</strong> harder than on dry ones, while my pace barely
          changes.
        </p>
        <svg viewBox={`0 0 ${WW} ${WH}`} role="img" aria-labelledby="weather-title weather-desc">
          <desc id="weather-desc">
            {dots.map((d) => `Dew point ${dewLabel(d)}: median heart rate ${d.heartRate} bpm, pace ${pace(d.paceSecPerKm!)}, ${d.runs} runs`).join('; ')}
          </desc>
          <polyline points={dots.map((d) => `${d.x},${d.y}`).join(' ')} class="line" />
          {
            dots.map((d) => (
              <g class="pt" tabindex="0" aria-label={`Dew point ${dewLabel(d)}: ${d.heartRate} bpm over ${d.runs} runs`}>
                <title>{`Dew point ${dewLabel(d)} · ${d.heartRate} bpm · ${pace(d.paceSecPerKm!)} · ${d.runs} runs`}</title>
                <rect x={d.x - wSlot / 2} y="0" width={wSlot} height={WH} class="hit" />
                <circle cx={d.x} cy={d.y} r="6" class="dot" />
                <text x={d.x} y={d.y - 16} class="value">{d.heartRate} bpm</text>
                <text x={d.x} y={wBase + 40} class="year" data-dew-f={dewLabel(d)} data-dew-c={dewLabel(d, true)}>
                  {dewLabel(d)}
                </text>
                <text x={d.x} y={wBase + 60} class="note" data-pace={d.paceSecPerKm}>
                  {pace(d.paceSecPerKm!)}
                </text>
              </g>
            ))
          }
        </svg>
        <p class="method">
          Dew point at the time of each run, from <a href="https://open-meteo.com/">Open-Meteo</a>’s historical weather.
          Medians of {weather.runs} outdoor runs; treadmill runs left out.
        </p>
      </section>
    )
  }
  {
    runningPhotos.length > 0 && (
      <section class="photos">
        <PhotoGrid photos={runningPhotos} rowHeight={360} contentWidth={704} />
        <Lightbox photos={runningPhotos} details={false} />
      </section>
    )
  }
</Base>

<style>
  .page-head {
    padding: 3rem 0 2.5rem;
  }
  h1 {
    margin: 0;
    font: 400 clamp(2.4rem, 6vw, 3.5rem) / 1 var(--display);
    letter-spacing: -0.03em;
  }
  .intro {
    max-width: var(--measure);
    margin: 1rem 0 0;
    font: 400 1.2rem / 1.5 var(--display);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 1px;
    margin: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--rule);
  }
  .stats div {
    padding: 1.1rem 1.25rem;
    background: var(--surface);
  }
  .stats dt {
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }
  .stats dd {
    margin: 0.3rem 0 0;
    font: 400 1.7rem / 1.1 var(--display);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .pb-title {
    margin: 2rem 0 0.75rem;
    font-weight: 500;
  }
  .milestones {
    max-width: 44rem;
    margin-top: 3.5rem;
  }
  .milestones .kicker {
    margin: 0 0 1.25rem;
  }
  .milestones ol {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* the line joining the dots */
  .milestones ol::before {
    content: '';
    position: absolute;
    top: 0.6rem;
    bottom: 0.6rem;
    left: 5px;
    width: 2px;
    background: var(--rule);
  }
  .milestones li {
    position: relative;
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    align-items: baseline;
    gap: 0 1rem;
    padding: 0.55rem 0 0.55rem 1.75rem;
  }
  .milestones li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .milestones li:last-child::before {
    background: var(--accent);
  }
  .milestones time {
    color: var(--muted);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  .milestones .what {
    font: 400 1.15rem var(--display);
  }
  .milestones .time {
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .milestones li {
      grid-template-columns: 1fr auto;
    }
    .milestones time {
      grid-column: 1 / -1;
    }
  }
  .chart {
    margin-top: 3.5rem;
    max-width: 44rem;
    --bar: #b4532a;
  }
  :global([data-effective-theme='dark']) .chart {
    --bar: #d4683f;
  }
  .chart .kicker {
    margin: 0 0 1rem;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .axis {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .hit {
    fill: transparent;
  }
  .fill {
    fill: var(--bar);
    transition: opacity var(--ease);
  }
  .bar:hover .fill,
  .bar:focus-visible .fill {
    opacity: 0.8;
  }
  .bar:focus-visible {
    outline: none;
  }
  .bar:focus-visible .hit {
    stroke: var(--accent);
    stroke-width: 2;
  }
  .value {
    fill: var(--fg);
    font: 500 15px var(--body);
    text-anchor: middle;
    font-variant-numeric: tabular-nums;
  }
  .year {
    fill: var(--fg);
    font: 400 15px var(--body);
    text-anchor: middle;
  }
  .note {
    fill: var(--muted);
    font: 400 13px var(--body);
    text-anchor: middle;
  }
  .finding {
    margin: 0 0 1.25rem;
    font: 400 1.15rem / 1.5 var(--display);
  }
  .finding strong {
    font-weight: 500;
    color: var(--accent);
  }
  .line {
    fill: none;
    stroke: var(--bar);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .dot {
    fill: var(--bar);
    stroke: var(--bg);
    stroke-width: 2;
    transition: r var(--ease);
  }
  .pt:hover .dot,
  .pt:focus-visible .dot {
    r: 8;
  }
  .pt:focus-visible {
    outline: none;
  }
  .method {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .method a {
    color: inherit;
  }
  .photos {
    max-width: 44rem;
    margin-top: 3.5rem;
  }
</style>

<script>
  // Re-render distances in the visitor's unit (imperial by default).
  const KM_PER_MILE = 1.609344;
  function render() {
    const metric = document.documentElement.dataset.units === 'metric';
    document.querySelectorAll<HTMLElement | SVGTextElement>('[data-meters]').forEach((el) => {
      const m = Number(el.dataset.meters);
      const value = metric ? m / 1000 : m / (1000 * KM_PER_MILE);
      el.textContent = `${Math.round(value).toLocaleString('en-US')} ${metric ? 'km' : 'mi'}`;
    });
    document.querySelectorAll<SVGTextElement>('[data-dew-f]').forEach((el) => {
      el.textContent = (metric ? el.dataset.dewC : el.dataset.dewF) ?? '';
    });
    document.querySelectorAll<SVGTextElement>('[data-pace]').forEach((el) => {
      const s = Math.round(Number(el.dataset.pace) * (metric ? 1 : KM_PER_MILE));
      el.textContent = `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')} /${metric ? 'km' : 'mi'}`;
    });
  }
  render();
  document.addEventListener('unitschange', render);
</script>
