---
// Home: hero from site.yaml. Section teasers arrive in Phase 6.
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
import { isLive } from '../data/nav';

// Link hobby mentions in the bio to their pages once those pages are live.
const BIO_LINKS: [phrase: string, href: string][] = [
  ['pour latte art', '/coffee/'],
  ['take photos', '/photos/'],
];
type Part = string | { text: string; href: string };
const bioParts = BIO_LINKS.reduce<Part[]>(
  (parts, [phrase, href]) =>
    isLive(href.replace(/\/$/, ''))
      ? parts.flatMap((part) =>
          typeof part === 'string' && part.includes(phrase)
            ? part.split(phrase).flatMap((piece, i) => (i === 0 ? [piece] : [{ text: phrase, href }, piece]))
            : [part],
        )
      : parts,
  [site.bio],
);

const [before, after] = site.positioningEmphasis
  ? site.positioning.split(site.positioningEmphasis)
  : [site.positioning, undefined];
---

<Base title={site.name}>
  <section class="hero">
    <h1>
      {site.name}
      {site.nameZh && <span class="zh" lang="zh-Hans">{site.nameZh}</span>}
    </h1>
    <p class="lede">
      {before}{after !== undefined && <em>{site.positioningEmphasis}</em>}{after}
    </p>
    <p class="bio">
      {bioParts.map((part) => (typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>))}
    </p>
    <div class="actions">
      {isLive('/resume') && <a class="btn btn-primary" href="/resume">Resume</a>}
      <a class="btn" href={site.links.linkedin}>LinkedIn ↗</a>
      {site.links.email && <a class="btn" href={`mailto:${site.links.email}`}>Email</a>}
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 4rem 0 2rem;
  }
  @media (min-width: 880px) {
    .hero {
      padding: 6rem 0 3rem;
    }
  }
  h1 {
    margin: 0;
    font: 400 clamp(3rem, 8vw, 5.5rem) / 0.95 var(--display);
    letter-spacing: -0.035em;
  }
  .zh {
    display: block;
    margin-top: 0.9rem;
    font: 300 1.35rem var(--display);
    letter-spacing: 0.25em;
    color: var(--muted);
  }
  .lede {
    max-width: var(--measure);
    margin: 2rem 0 0;
    font: 400 1.45rem / 1.4 var(--display);
    letter-spacing: -0.01em;
  }
  .lede em {
    color: var(--accent);
    font-style: italic;
  }
  .bio {
    max-width: var(--measure);
    margin: 1.25rem 0 0;
    color: var(--muted);
  }
  .bio a {
    color: inherit;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--ease), color var(--ease);
  }
  .bio a:hover {
    color: var(--fg);
    text-decoration-color: currentColor;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
</style>
