---
// Home: hero from site.yaml. Section teasers arrive in Phase 6.
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
import { isLive } from '../data/nav';

// Link the hobby mention in the bio to the gallery once it's live.
const PHOTO_PHRASE = 'take photos';
const [bioBefore, bioAfter] =
  isLive('/photos') && site.bio.includes(PHOTO_PHRASE) ? site.bio.split(PHOTO_PHRASE) : [site.bio, undefined];

const [before, after] = site.positioningEmphasis
  ? site.positioning.split(site.positioningEmphasis)
  : [site.positioning, undefined];
---

<Base title={site.name}>
  <section class="hero">
    <h1>
      {site.name}
      {site.nameZh && <span class="zh" lang="zh-Hans">{site.nameZh}</span>}
    </h1>
    <p class="lede">
      {before}{after !== undefined && <em>{site.positioningEmphasis}</em>}{after}
    </p>
    <p class="bio">
      {bioBefore}{bioAfter !== undefined && <a href="/photos/">{PHOTO_PHRASE}</a>}{bioAfter}
    </p>
    <div class="actions">
      {isLive('/resume') && <a class="btn btn-primary" href="/resume">Resume</a>}
      <a class="btn" href={site.links.linkedin}>LinkedIn ↗</a>
      {site.links.email && <a class="btn" href={`mailto:${site.links.email}`}>Email</a>}
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 4rem 0 2rem;
  }
  @media (min-width: 880px) {
    .hero {
      padding: 6rem 0 3rem;
    }
  }
  h1 {
    margin: 0;
    font: 400 clamp(3rem, 8vw, 5.5rem) / 0.95 var(--display);
    letter-spacing: -0.035em;
  }
  .zh {
    display: block;
    margin-top: 0.9rem;
    font: 300 1.35rem var(--display);
    letter-spacing: 0.25em;
    color: var(--muted);
  }
  .lede {
    max-width: var(--measure);
    margin: 2rem 0 0;
    font: 400 1.45rem / 1.4 var(--display);
    letter-spacing: -0.01em;
  }
  .lede em {
    color: var(--accent);
    font-style: italic;
  }
  .bio {
    max-width: var(--measure);
    margin: 1.25rem 0 0;
    color: var(--muted);
  }
  .bio a {
    color: inherit;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--ease), color var(--ease);
  }
  .bio a:hover {
    color: var(--fg);
    text-decoration-color: currentColor;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
</style>
