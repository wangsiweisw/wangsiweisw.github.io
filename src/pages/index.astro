---
// Home: hero from site.yaml. Section teasers arrive in Phase 6.
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
import { isLive } from '../data/nav';
import { photos, srcset } from '../lib/photos';
import WindField from '../components/WindField.astro';
import IsobarField from '../components/IsobarField.astro';
import PrecipField from '../components/PrecipField.astro';
import WeatherCard from '../components/WeatherCard.astro';
import TempBand from '../components/TempBand.astro';

const fx = new Set(site.heroEffects);

const portrait = site.portrait ? photos.find((p) => p.file === site.portrait) : undefined;

// schema.org Person: helps search engines connect this site, the name, and the LinkedIn profile.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.nameZh,
  url: new URL('/', Astro.site).href,
  description: site.description,
  jobTitle: 'Software Engineer',
  image: portrait?.webp.find((v) => v.width >= 960)?.url,
  sameAs: [site.links.linkedin],
  alumniOf: site.education.map((s) => ({
    '@type': 'CollegeOrUniversity',
    name: s.name,
    alternateName: s.alternateName,
  })),
};

// Link hobby mentions in the bio to their pages once those pages are live.
const BIO_LINKS: [phrase: string, href: string][] = [
  ['run', '/running/'],
  ['pour latte art', '/coffee/'],
  ['take photos', '/photos/'],
];
type Part = string | { text: string; href: string };
const bioParts = BIO_LINKS.reduce<Part[]>(
  (parts, [phrase, href]) =>
    isLive(href.replace(/\/$/, ''))
      ? parts.flatMap((part) => {
          // whole words only, so "run" doesn't also link "running"
          const re = new RegExp(`\\b${phrase.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b`);
          return typeof part === 'string' && re.test(part)
            ? part.split(re).flatMap((piece, i) => (i === 0 ? [piece] : [{ text: phrase, href }, piece]))
            : [part];
        })
      : parts,
  [site.bio],
);

const [before, after] = site.positioningEmphasis
  ? site.positioning.split(site.positioningEmphasis)
  : [site.positioning, undefined];
---

<Base title={site.nameZh ? `${site.name} ${site.nameZh}` : site.name}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
  <section class:list={['hero', { 'has-portrait': portrait }]}>
    {fx.has('band') && <TempBand />}
    {fx.has('isobars') && <IsobarField />}
    {fx.has('wind') && <WindField />}
    {fx.has('precip') && <PrecipField />}
    {
      portrait && (
        <figure class="portrait">
          <span class="ph" style={`background-image: url(${portrait.placeholder})`} aria-hidden="true" />
          <picture>
            <source type="image/avif" srcset={srcset(portrait.avif)} sizes="(min-width: 880px) 660px, 240px" />
            <img
              src={portrait.webp.find((v) => v.width >= 960)?.url ?? portrait.webp.at(-1)!.url}
              srcset={srcset(portrait.webp)}
              sizes="(min-width: 880px) 660px, 240px"
              width={portrait.width}
              height={portrait.height}
              alt={portrait.alt ?? ''}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </figure>
      )
    }
    <div class="text">
      <h1>
        {site.name}
        {site.nameZh && <span class="zh" lang="zh-Hans">{site.nameZh}</span>}
      </h1>
      <p class="lede">
        {before}{after !== undefined && <em>{site.positioningEmphasis}</em>}{after}
      </p>
      <p class="bio">
        {bioParts.map((part) => (typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>))}
      </p>
      <div class="actions">
        {isLive('/resume') && <a class="btn btn-primary" href="/resume">Resume</a>}
        <a class="btn" href={site.links.linkedin}>LinkedIn <span class="arrow" aria-hidden="true">↗</span></a>
        {site.links.email && <a class="btn" href={`mailto:${site.links.email}`}>Email</a>}
      </div>
      {fx.has('card') && <WeatherCard />}
      <p class="wind-caption" data-hero-caption hidden>
        <span class="dot"></span><span data-hero-caption-text></span>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    padding: 4rem 0 2rem;
  }
  .hero > .text,
  .hero > .portrait {
    position: relative;
    z-index: 1;
  }
  /* portrait: small, above the name on phones; beside the text on wide screens */
  .portrait {
    position: relative;
    width: 7.5rem;
    aspect-ratio: 4 / 5;
    margin: 0 0 2rem;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
  }
  .portrait .ph {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: 52% 50%;
    filter: blur(12px);
    transform: scale(1.1);
  }
  .portrait img {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 50%;
  }
  @media (min-width: 880px) {
    .hero.has-portrait {
      display: grid;
      grid-template-columns: 1fr 19rem;
      gap: 4rem;
      align-items: center;
    }
    .has-portrait .portrait {
      grid-column: 2;
      grid-row: 1;
      width: 100%;
      margin: 0;
      box-shadow: 0 1px 0 var(--rule), 0 24px 48px -32px rgba(60, 40, 20, 0.45);
    }
  }
  @media (min-width: 880px) {
    .hero {
      padding: 6rem 0 3rem;
    }
  }
  h1 {
    margin: 0;
    font: 400 clamp(3rem, 8vw, 5.5rem) / 0.95 var(--display);
    letter-spacing: -0.035em;
  }
  .zh {
    display: block;
    margin-top: 0.9rem;
    font: 300 1.35rem var(--display);
    letter-spacing: 0.25em;
    color: var(--muted);
  }
  .lede {
    max-width: var(--measure);
    margin: 2rem 0 0;
    font: 400 1.45rem / 1.4 var(--display);
    letter-spacing: -0.01em;
  }
  .lede em {
    color: var(--accent);
    font-style: italic;
  }
  .bio {
    max-width: var(--measure);
    margin: 1.25rem 0 0;
    color: var(--muted);
  }
  /* hobby links: a thin rule that draws in with the accent on hover */
  .bio a {
    color: inherit;
    text-decoration: none;
    background:
      linear-gradient(var(--accent), var(--accent)) 0 100% / 0 1.5px no-repeat,
      linear-gradient(var(--rule), var(--rule)) 0 100% / 100% 1px no-repeat;
    transition: background-size 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), color 0.25s ease;
  }
  .bio a:hover {
    color: var(--fg);
    background-size: 100% 1.5px, 100% 1px;
  }
  /* staggered entrance */
  .text > *,
  .portrait {
    animation: rise 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .text > :nth-child(2) { animation-delay: 0.06s; }
  .text > :nth-child(3) { animation-delay: 0.12s; }
  .text > :nth-child(4) { animation-delay: 0.18s; }
  .text > :nth-child(n + 5) { animation-delay: 0.24s; }
  .portrait { animation-delay: 0.15s; }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  .wind-caption {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 2.5rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }
  .wind-caption[hidden] {
    display: none;
  }
  .wind-caption .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.3;
    }
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
</style>
