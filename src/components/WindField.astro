---
// Live wind field: faint particles drifting with the current 10 m wind over the New York region (Open-Meteo).
---

<wind-field class="wind" aria-hidden="true">
  <canvas></canvas>
</wind-field>

<style>
  .wind {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(ellipse 75% 75% at 50% 50%, #000 45%, transparent 100%);
    mask-image: radial-gradient(ellipse 75% 75% at 50% 50%, #000 45%, transparent 100%);
  }
  canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  // Grid of points spanning the NY region; Open-Meteo accepts comma-separated coordinate lists.
  const LAT = [43.0, 42.0, 41.0, 40.0, 39.0];
  const LON = [-77.0, -75.6, -74.2, -72.8, -71.4, -70.0];
  const CACHE_KEY = 'wind-grid-v1';

  type Grid = { u: number[][]; v: number[][]; speedKmh: number; dirDeg: number };

  async function loadGrid(): Promise<Grid | null> {
    try {
      const cached = JSON.parse(sessionStorage.getItem(CACHE_KEY) ?? 'null');
      if (cached && Date.now() - cached.t < 30 * 60 * 1000) return cached.g;
    } catch {}
    const lats: number[] = [];
    const lons: number[] = [];
    for (const la of LAT) for (const lo of LON) (lats.push(la), lons.push(lo));
    try {
      const res = await fetch(
        `https://api.open-meteo.com/v1/forecast?latitude=${lats}&longitude=${lons}&current=wind_speed_10m,wind_direction_10m`,
      );
      if (!res.ok) return null;
      const data = await res.json();
      const u: number[][] = [];
      const v: number[][] = [];
      LAT.forEach((_, r) => {
        u.push([]);
        v.push([]);
        LON.forEach((_, c) => {
          const cur = data[r * LON.length + c].current;
          const rad = (cur.wind_direction_10m * Math.PI) / 180; // direction the wind blows FROM
          u[r].push(-cur.wind_speed_10m * Math.sin(rad));
          v[r].push(-cur.wind_speed_10m * Math.cos(rad));
        });
      });
      // the point nearest Manhattan, for the caption
      const nyc = data[2 * LON.length + 2].current;
      const g = { u, v, speedKmh: nyc.wind_speed_10m, dirDeg: nyc.wind_direction_10m };
      try {
        sessionStorage.setItem(CACHE_KEY, JSON.stringify({ t: Date.now(), g }));
      } catch {}
      return g;
    } catch {
      return null;
    }
  }

  const COMPASS = ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'];

  class WindField extends HTMLElement {
    connectedCallback() {
      this.start();
    }

    async start() {
      const canvas = this.querySelector('canvas')!;
      const ctx = canvas.getContext('2d')!;
      const grid = await loadGrid();
      if (!grid) return; // no data: stay blank rather than fake it

      const caption = document.querySelector<HTMLElement>('[data-hero-caption]');
      const text = caption?.querySelector('[data-hero-caption-text]');
      if (caption && text && !caption.dataset.owner) {
        caption.dataset.owner = 'wind';
        const imperial = document.documentElement.dataset.units !== 'metric';
        const speed = imperial ? `${Math.round(grid.speedKmh / 1.609)} mph` : `${Math.round(grid.speedKmh)} km/h`;
        const from = COMPASS[Math.round(grid.dirDeg / 45) % 8];
        text.textContent = `Live wind over New York · ${speed} from the ${from}`;
        caption.hidden = false;
      }

      let W = 0;
      let H = 0;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      const resize = () => {
        W = canvas.clientWidth;
        H = canvas.clientHeight;
        canvas.width = W * dpr;
        canvas.height = H * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let redrawStill = () => {};
      resize();
      // resizing clears the canvas; in reduced-motion mode nothing repaints it, so redraw the still frame
      new ResizeObserver(() => (resize(), redrawStill())).observe(canvas);

      // bilinear sample of the wind grid at canvas position (x, y)
      const sample = (x: number, y: number): [number, number] => {
        const gx = (x / W) * (LON.length - 1);
        const gy = (y / H) * (LAT.length - 1);
        const c0 = Math.max(0, Math.min(LON.length - 2, Math.floor(gx)));
        const r0 = Math.max(0, Math.min(LAT.length - 2, Math.floor(gy)));
        const fx = gx - c0;
        const fy = gy - r0;
        const lerp = (m: number[][]) =>
          (m[r0][c0] * (1 - fx) + m[r0][c0 + 1] * fx) * (1 - fy) + (m[r0 + 1][c0] * (1 - fx) + m[r0 + 1][c0 + 1] * fx) * fy;
        return [lerp(grid.u), lerp(grid.v)];
      };

      const readAccent = () => getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#b4532a';
      let accent = readAccent();
      // follow light/dark switches
      new MutationObserver(() => (accent = readAccent())).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme', 'data-effective-theme'],
      });
      const count = Math.round((W * H) / 2200);
      const spawn = () => ({ x: Math.random() * W, y: Math.random() * H, age: Math.floor(Math.random() * 80) });
      const parts = Array.from({ length: count }, spawn);
      const SPEED = 0.045; // px per frame per km/h

      const step = () => {
        // fade existing trails while keeping the canvas transparent
        ctx.globalCompositeOperation = 'destination-in';
        ctx.fillStyle = 'rgba(0,0,0,0.93)';
        ctx.fillRect(0, 0, W, H);
        ctx.globalCompositeOperation = 'source-over';
        ctx.strokeStyle = accent;
        ctx.globalAlpha = 0.55;
        ctx.lineWidth = 1;
        ctx.beginPath();
        for (const p of parts) {
          const [u, v] = sample(p.x, p.y);
          const nx = p.x + u * SPEED;
          const ny = p.y - v * SPEED; // north is up
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(nx, ny);
          p.x = nx;
          p.y = ny;
          if (++p.age > 90 || nx < 0 || nx > W || ny < 0 || ny > H) Object.assign(p, spawn(), { age: 0 });
        }
        ctx.stroke();
        ctx.globalAlpha = 1;
      };

      if (still) {
        // a still snapshot of the flow: longer, stronger trails instead of motion
        redrawStill = () => {
          ctx.clearRect(0, 0, W, H);
          for (const p of parts) Object.assign(p, spawn(), { age: 0 });
          for (let i = 0; i < 70; i++) step();
        };
        redrawStill();
        return;
      }

      let running = true;
      let raf = 0;
      const loop = () => {
        step();
        raf = requestAnimationFrame(loop);
      };
      const setRunning = (on: boolean) => {
        if (on && !running) ((running = true), (raf = requestAnimationFrame(loop)));
        if (!on && running) ((running = false), cancelAnimationFrame(raf));
      };
      new IntersectionObserver(([e]) => setRunning(e.isIntersecting && !document.hidden)).observe(canvas);
      document.addEventListener('visibilitychange', () => setRunning(!document.hidden));
      raf = requestAnimationFrame(loop);
    }
  }

  customElements.define('wind-field', WindField);
</script>
