---
// Site footer: copyright line.
import { site } from '../lib/site';
---

<footer class="wrap">
  <div class="site-footer">
    <span>© {new Date().getFullYear()} {site.name}</span>
  </div>
</footer>

<style>
  footer {
    margin-top: 5rem;
  }
  .site-footer {
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
