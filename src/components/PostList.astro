---
// List of posts: date, title, description, draft badge (dev only).
import { formatDate, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">No posts yet.</p>
  ) : (
    <ol class="posts">
      {posts.map((post) => (
        <li>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <div>
            <a class="title" href={`/blog/${post.id}/`}>
              {post.data.title}
            </a>
            {post.data.draft && <span class="draft">Draft</span>}
            <p>{post.data.description}</p>
          </div>
        </li>
      ))}
    </ol>
  )
}

<style>
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  li {
    display: grid;
    gap: 0.25rem 2rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 720px) {
    li {
      grid-template-columns: 8rem 1fr;
    }
  }
  time {
    padding-top: 0.2rem;
    color: var(--muted);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  .title {
    font: 400 1.35rem / 1.3 var(--display);
    text-decoration: none;
  }
  .title:hover {
    color: var(--accent);
  }
  p {
    margin: 0.3rem 0 0;
    color: var(--muted);
  }
  .draft {
    margin-left: 0.6rem;
    padding: 0.1rem 0.5rem;
    border: 1px dashed var(--accent);
    border-radius: 99px;
    color: var(--accent);
    font-size: 0.75rem;
    vertical-align: 0.25em;
  }
  .empty {
    color: var(--muted);
  }
</style>
