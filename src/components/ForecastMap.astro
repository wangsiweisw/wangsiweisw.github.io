---
// Forecast map: animated 10-day fields around the selected city from AIFS, IFS and GFS on a Leaflet basemap.
// Markup and styles here; behaviour in src/scripts/forecast-map.ts, data in src/scripts/fx-data.ts.
import 'leaflet/dist/leaflet.css';
---

<forecast-map>
  <div class="map-controls">
    <div class="chips" role="group" aria-label="Map layer">
      <button type="button" class="chip" data-layer="temp" aria-pressed="true">Temperature</button>
      <button type="button" class="chip" data-layer="precip" aria-pressed="false">Precipitation</button>
      <button type="button" class="chip" data-layer="wind" aria-pressed="false">Wind</button>
      <button type="button" class="chip" data-layer="sun" aria-pressed="false" data-pre-only hidden>Sunshine</button>
      <button type="button" class="chip" data-layer="cloud" aria-pressed="false" data-pre-only hidden>Clouds</button>
      <button type="button" class="chip" data-layer="z500" aria-pressed="false" data-pre-only hidden>500 hPa</button>
      <button type="button" class="chip" data-layer="total" aria-pressed="false" data-pre-only hidden>10-day rain</button>
      <button type="button" class="chip" data-layer="diff" aria-pressed="false">Temp: AIFS − IFS</button>
    </div>
    <div class="chips" role="group" aria-label="Model" data-model-group>
      <button type="button" class="chip" data-model="aifs" aria-pressed="true">AIFS</button>
      <button type="button" class="chip" data-model="ifs" aria-pressed="false">IFS</button>
      <button type="button" class="chip" data-model="gfs" aria-pressed="false">GFS</button>
    </div>
  </div>

  <div class="map-frame">
    <div class="map" data-map></div>
    <p class="map-status" data-map-status>Map loads when you scroll here…</p>
    <div class="readout" data-readout hidden></div>
    <div class="legend-bar" data-legend hidden>
      <span class="legend-title" data-legend-title></span>
      <span class="ramp" data-ramp></span>
      <span class="ticks" data-ticks></span>
    </div>
  </div>

  <div class="timeline">
    <button type="button" class="play" data-play aria-label="Play">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
    </button>
    <input type="range" min="0" max="0" value="0" step="1" data-time aria-label="Forecast time" />
    <output data-time-label>—</output>
  </div>
  <div class="map-options">
    <label class="toggle" data-pre-only hidden>
      <input type="checkbox" data-isobars />
      <span>Show isobars <span class="hint">(sea-level pressure every 4 hPa, with highs H and lows L)</span></span>
    </label>
    <p class="run-note" data-run></p>
  </div>
</forecast-map>

<style>
  forecast-map {
    display: block;
  }
  .map-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chips[hidden] {
    display: none;
  }
  .chip {
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 99px;
    background: transparent;
    color: var(--fg);
    font: 500 0.85rem var(--body);
    cursor: pointer;
  }
  .chip[hidden] {
    display: none;
  }
  .chip[aria-pressed='true'] {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  .map-frame {
    position: relative;
    margin-top: 1rem;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--surface);
  }
  .map {
    height: min(62vh, 520px);
    min-height: 320px;
  }
  @media (max-width: 640px) {
    .map {
      height: auto;
      min-height: 0;
      aspect-ratio: 1;
    }
  }
  .map {
    background: var(--surface);
    cursor: crosshair;
  }
  .map-status {
    position: absolute;
    inset: 0;
    /* above Leaflet's panes (z-index up to 700), or tiles hide it */
    z-index: 800;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 1rem;
    color: var(--fg);
    text-align: center;
    pointer-events: none;
    background: color-mix(in srgb, var(--bg) 55%, transparent);
  }
  .map-status :global(button) {
    pointer-events: auto;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--surface);
    color: var(--fg);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .map-status[hidden] {
    display: none;
  }
  .readout {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 500;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(6px);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }
  .legend-bar {
    position: absolute;
    left: 10px;
    bottom: 10px;
    z-index: 500;
    display: grid;
    gap: 0.25rem;
    width: min(260px, 60%);
    padding: 0.5rem 0.65rem 0.4rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(6px);
    font-size: 0.75rem;
  }
  .legend-bar[hidden] {
    display: none;
  }
  .legend-title {
    color: var(--muted);
  }
  .ramp {
    display: block;
    height: 8px;
    border-radius: 4px;
  }
  .ticks {
    display: flex;
    justify-content: space-between;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .timeline {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9rem;
    margin-top: 0.75rem;
  }
  .play {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }
  .play:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .play svg {
    width: 1rem;
    height: 1rem;
  }
  input[type='range'] {
    width: 100%;
    accent-color: var(--accent);
  }
  input[type='range']:disabled,
  .play:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .map-options {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.4rem 1.5rem;
    margin-top: 0.6rem;
  }
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .toggle[hidden] {
    display: none;
  }
  .toggle input {
    accent-color: var(--accent);
  }
  .toggle .hint {
    color: var(--muted);
  }
  .run-note {
    margin: 0;
    color: var(--muted);
    font-size: 0.75rem;
  }
  /* pressure centres */
  .map :global(.hl) {
    display: grid;
    place-items: center;
    line-height: 1;
    color: var(--fg);
    text-shadow: 0 0 3px var(--bg), 0 0 3px var(--bg);
    pointer-events: none;
  }
  .map :global(.hl b) {
    font: 600 18px var(--display);
  }
  .map :global(.hl span) {
    font: 10px var(--body);
    font-variant-numeric: tabular-nums;
  }
  .map :global(.hl-L b) {
    color: var(--accent);
  }
  output {
    min-width: 9.5rem;
    color: var(--muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  /* keep Leaflet chrome in the site's palette */
  .map :global(.leaflet-control-attribution) {
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    color: var(--muted);
    font-size: 10px;
  }
  .map :global(.leaflet-control-attribution a) {
    color: var(--muted);
  }
  .map :global(.leaflet-bar a) {
    background: var(--bg);
    color: var(--fg);
    border-color: var(--rule);
  }
  .map :global(.wind-canvas) {
    position: absolute;
    inset: 0;
    z-index: 450;
    pointer-events: none;
  }
  .map :global(.osm-muted) {
    filter: grayscale(1) contrast(0.85) brightness(1.05);
    opacity: 0.75;
  }
  :global([data-effective-theme='dark']) .map :global(.osm-muted) {
    filter: grayscale(1) invert(1) contrast(0.8) brightness(0.9);
    opacity: 0.6;
  }
  .map :global(.pick-popup .leaflet-popup-content-wrapper),
  .map :global(.pick-popup .leaflet-popup-tip) {
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 10px 24px -14px rgba(30, 20, 10, 0.5);
  }
  .map :global(.pick-popup .leaflet-popup-content) {
    margin: 0.55rem 0.7rem;
  }
  .map :global(.pick) {
    display: grid;
    gap: 0.4rem;
    font: 0.8rem var(--body);
    font-variant-numeric: tabular-nums;
  }
  .map :global(.pick button) {
    padding: 0.3rem 0.7rem;
    border: 0;
    border-radius: 99px;
    background: var(--fg);
    color: var(--bg);
    font: 500 0.8rem var(--body);
    cursor: pointer;
  }
  .map :global(.city-dot) {
    width: 10px;
    height: 10px;
    border: 2px solid var(--bg);
    border-radius: 50%;
    background: var(--fg);
    box-shadow: 0 0 0 1px var(--fg);
  }
</style>

<script>
  import '../scripts/forecast-map';
</script>
