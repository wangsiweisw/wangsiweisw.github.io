---
// Site header: name, section nav, preference toggles.
import { visibleNav } from '../data/nav';
import ThemeToggle from './ThemeToggle.astro';
import UnitToggle from './UnitToggle.astro';

interface Props {
  showUnits?: boolean;
}

const { showUnits = false } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '');
---

<header class="site-header wrap">
  <a class="brand" href="/">Siwei Wang</a>
  <nav class="nav" aria-label="Main">
    {
      visibleNav.length > 0 && (
        <ul class="nav-links">
          {visibleNav.map((item) => (
            <li>
              <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <div class="toggles">
      {showUnits && <UnitToggle />}
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.75rem;
    padding-bottom: 1.75rem;
  }
  .brand {
    font: 500 1.15rem var(--display);
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.95rem;
  }
  .nav-links {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* phones: name + toggles on the first row, section links on a second row */
  @media (max-width: 719px) {
    .site-header {
      flex-wrap: wrap;
      row-gap: 0.75rem;
    }
    .nav {
      display: contents;
    }
    .nav-links {
      order: 3;
      width: 100%;
      gap: 1.25rem;
      overflow-x: auto;
      font-size: 0.9rem;
      white-space: nowrap;
    }
  }
  .nav-links a {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--ease);
  }
  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--fg);
  }
  .toggles {
    display: flex;
    gap: 0.25rem;
  }
</style>
