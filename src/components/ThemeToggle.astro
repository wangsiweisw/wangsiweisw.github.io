---
// Light/dark toggle. The initial theme is applied by an inline script in Base.astro to avoid a flash.
---

<theme-toggle>
  <button class="toggle" type="button" aria-label="Toggle dark theme" aria-pressed="false">
    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
    </svg>
    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
    </svg>
  </button>
</theme-toggle>

<style>
  button {
    position: relative;
  }
  svg {
    grid-area: 1 / 1;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s ease !important;
  }
  .icon-sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }
  :global([data-effective-theme='dark']) .icon-moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }
  :global([data-effective-theme='dark']) .icon-sun {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  import { autoTheme, effectiveTheme, setTheme } from '../scripts/prefs';

  class ThemeToggle extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button')!;
      const sync = () => button.setAttribute('aria-pressed', String(effectiveTheme() === 'dark'));
      sync();
      // Until the visitor picks a theme, follow the OS setting and sunrise/sunset (checked every minute).
      const follow = () => {
        if (document.documentElement.dataset.theme) return;
        const next = autoTheme();
        if (document.documentElement.dataset.effectiveTheme === next) return;
        document.documentElement.dataset.effectiveTheme = next;
        sync();
      };
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', follow);
      setInterval(follow, 60_000);
      button.addEventListener('click', () => {
        setTheme(effectiveTheme() === 'dark' ? 'light' : 'dark');
        sync();
      });
    }
  }
  customElements.define('theme-toggle', ThemeToggle);
</script>
